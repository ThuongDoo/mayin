---
import Icon from './Icon.astro';
import { settings, telHref, zaloHref } from '../lib/site';
interface Props { center?: boolean; light?: boolean }
const { center = false, light = false } = Astro.props;
---
<div class:list={['cta-row', { center, light }]}>
  <a class="btn btn-call" href={telHref}><Icon name="phone" />Gọi ngay<span class="hide-sm"> {settings.phoneText}</span></a>
  <a class="btn btn-zalo" href={zaloHref} target="_blank" rel="noopener">Nhắn Zalo</a>
</div>
